      <revhistory xml:id="rh-cpu-check-temperature">
        <revision><date>2026-09-04</date>
          <revdescription>
            <para>
              Updated for &productname; &productnumber;:
            </para>
            <itemizedlist>
              <listitem>
                <para>
                  Added how to read the temperature from the ACPI thermal
                  zones, which needs no additional software, and how to tell
                  which readings come through ACPI
                </para>
              </listitem>
              <listitem>
                <para>
                  Changed the <command>sensors-detect</command> step to an
                  optional step and added the warning of its man page against
                  running it on production servers
                </para>
              </listitem>
              <listitem>
                <para>
                  Added how to install the <package>sensors</package> package
                  on systems with a read-only root file system
                </para>
              </listitem>
              <listitem>
                <para>
                  Replaced the <package>hardinfo</package> package, which is no
                  longer available, with <package>s-tui</package> and removed
                  the <package>acpi</package> package, which is no longer
                  available
                </para>
              </listitem>
              <listitem>
                <para>
                  Removed the notes about the availability of the
                  <package>sensors</package> package and of ACPI on IBM Z
                </para>
              </listitem>
            </itemizedlist>
          </revdescription>
        </revision>
        <revision><date>2023-08-15</date>
