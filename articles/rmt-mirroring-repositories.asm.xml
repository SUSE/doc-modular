      <title>Mirroring repositories on an RMT server</title>
      <revhistory xml:id="rh-rmt-mirroring-repositories">
        <revision><date>2026-07-20</date>
          <revdescription>
            <para>
              Initial version. Migrated from the SLE Repository Mirroring Tool
