 xmlns:trans="http://docbook.org/ns/transclusion">
  <info>
    <title>MariaDB update strategy</title>
    <meta name="maintainer" content="daria.vladykina@suse.com" its:translate="no"/>
    <abstract>
      <para>
       MariaDB is a high-performance, open source relational database management system (RDBMS) that 
       was created as a community-developed fork of MySQL to ensure the software remains free and 
       accessible under the GPL license.
      </para>
    </abstract>
  </info>
  
  <variablelist>
    <varlistentry>
      <term>Lifecycle category</term>
      <listitem><para>Balanced. Only upstream LTS MariaDB releases are supported.</para></listitem>
    </varlistentry>
    <varlistentry>
      <term>Versions</term>
      <listitem><para>Each minor release gets a new MariaDB version. The starting version is 11.4.5.</para></listitem>
    </varlistentry>
    <varlistentry>
      <term>Support phases</term>
      <listitem>
        <para>Each version is supported for the General Support and LTS periods of its minor release.</para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Minor version updates</term>
      <listitem><para>Aligned with upstream releases and provided exclusively for the <package>mariadb</package> 
          and <package>mariadb-connector-c</package> packages.</para></listitem>
    </varlistentry>
  </variablelist>
  
</topic>
