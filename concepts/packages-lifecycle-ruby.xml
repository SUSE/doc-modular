       xmlns:trans="http://docbook.org/ns/transclusion">
  <info>
    <title>Ruby delivery strategy</title>
    <meta name="maintainer" content="daria.vladykina@suse.com" its:translate="no"/>
    <abstract>
      <para>
        The Ruby stack is not delivered as a standard component of &suselinux;&nbsp;16.
      </para>
    </abstract>
  </info>
  <para>
    However, specific components that depend on Ruby include it as a supported dependency.
  </para>
  <variablelist>
    <varlistentry>
      <term>Lifecycle category</term>
      <listitem>
        <para>
          Not applicable. Ruby is supported only as a dependency of the components below.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Hawk</term>
      <listitem>
        <para>
          Part of &sleha;. It is built on Ruby on Rails and requires a Ruby runtime.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>RMT (Repository Mirroring Tool)</term>
      <listitem>
        <para>
          Requires Ruby. Ruby is provided as a supported exception.
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
</topic>
