<topic xml:id="reference-deployment-sle16-system-requirements"
 role="reference" xml:lang="en"
 xmlns="http://docbook.org/ns/docbook" version="5.2"
 xmlns:its="http://www.w3.org/2005/11/its"
 xmlns:xi="http://www.w3.org/2001/XInclude"
 xmlns:xlink="http://www.w3.org/1999/xlink"
 xmlns:trans="http://docbook.org/ns/transclusion">
  <info>
   <title>System requirements</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
        The installation needs the following minimum resources for &productname;. 
        This section also lists recommendations for specific uses. 
      </para>
    </abstract>
  </info>
  <variablelist>
    <title>Minimum system requirements for installation</title>
    <varlistentry>
      <term>CPU</term>
      <listitem>
        <para arch="arm">
          Armv8.0-A or higher
        </para>
        <para arch="power">
          POWER10 or higher
        </para>
        <para arch="x86_64">
           &amd64; or &intel64;, micro architecture level x86-64-v2 or higher
        </para>
        <para arch="zseries">
          z14 or higher
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Memory</term>
      <listitem>
        <para arch="arm;x86_64;zseries">
          1024 MiB RAM
        </para>
        <para arch="power">
          2048 MiB RAM
        </para>
        <para arch="arm;x86_64;zseries">
          512 MiB Swap recommended
        </para>
        <para arch="power">
          1024 MiB Swap recommended
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Hard disk</term>
      <listitem>
        <para>
          2 GiB available disk space (more recommended, 8.5 GiB for all patterns)
32 GiB for snapshot/rollback of the OS
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
  <itemizedlist>
    <title>Recommendations for specific uses</title>
    <listitem>
      <para>
        1 GiB to 8 GiB RAM, at least 512 MiB per CPU
      </para>
    </listitem>
    <listitem>
      <para>
        8 GiB hard-disk space, 32 GiB for snapshot/rollback of the OS
      </para>
    </listitem>
    <listitem>
      <para>
        For print servers: a faster processor or additional processors to improve server-based printing
      </para>
    </listitem>
    <listitem>
      <para>
        For Web servers: additional RAM to improve caching and additional 
        processors to improve Web application performance
      </para>
    </listitem>
    <listitem>
      <para>
        For database servers: additional RAM to improve caching and multiple disks for parallel I/O
      </para>
    </listitem>
    <listitem>
      <para>
        For file servers: additional memory and disks, or a RAID system, to improve I/O throughput
      </para>
    </listitem>
    <listitem>
      <para>
        For SAP applications: additional memory and disks as recommended by SAP
      </para>
    </listitem>
  </itemizedlist>
</topic>
