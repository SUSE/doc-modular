  <info>
    <title>Starting the installation</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
        Review the configuration in the installation overview.
      </para>
    </abstract>
  </info>
  <figure xml:id="fig-deployment-manual-start-installation">
    <title>&agama; installer installation confirmation</title>
    <mediaobject>
      <textobject role="description">
        <phrase>Screenshot of the &agama; installer for &productname; &productnumber; showing a
          modal dialog to confirm the start of the installation.</phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata fileref="agama-installation-sles-confirm-installation.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata fileref="agama-installation-sles-confirm-installation.png" width="100%"/>
      </imageobject>
    </mediaobject>
  </figure>
  <para>
    Click <guimenu>Confirm and install</guimenu> to start the installation.
  </para>    
  <para>
    Wait for the system installation to complete. The time of the installation depends on the
    system's performance, the installation size and your network connection speed.
  </para>
  <tip>
    <title>Installation logs</title>
    <para>
    You can use the arrow menu in the top right corner of the window to view the logs and
    system messages.
    </para>
  </tip>
