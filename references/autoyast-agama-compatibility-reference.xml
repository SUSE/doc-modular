  <section xml:id="autoyast-services-manager">
    <title><literal>services-manager</literal></title>
    <para>
      This section is supported. &agama; does not implement support for enabling or disabling
      services on demand, so this section is converted into a post-installation script that
      enables or disables the services instead.
    </para>
    <table frame="all">
      <title><literal>services-manager</literal> compatibility</title>
      <tgroup cols="4">
        <thead>
          <row><entry>&ay;</entry><entry>Supported</entry><entry>&agama;</entry><entry>Notes</entry></row>
        </thead>
        <tbody>
          <row><entry><literal>default_target</literal></entry><entry>Supported</entry><entry/><entry>Added as a <command>systemctl set-default</command> call in the post-installation script.</entry></row>
          <row><entry><literal>enable[]</literal></entry><entry>Supported</entry><entry/><entry>Services are enabled in the post-installation script.</entry></row>
          <row><entry><literal>disable[]</literal></entry><entry>Supported</entry><entry/><entry>Services are disabled in the post-installation script.</entry></row>
          <row><entry><literal>on_demand[]</literal></entry><entry>Supported</entry><entry/><entry>Services are enabled on demand in the post-installation script.</entry></row>
        </tbody>
      </tgroup>
    </table>
  </section>
