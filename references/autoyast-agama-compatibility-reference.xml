          </thead>
          <tbody>
            <row><entry><literal>filename</literal></entry><entry>Supported</entry><entry><literal>scripts.init[].name</literal></entry><entry/></row>
            <row><entry><literal>location</literal></entry><entry>Supported</entry><entry><literal>scripts.init[].url</literal></entry><entry/></row>
            <row><entry><literal>source</literal></entry><entry>Supported</entry><entry><literal>scripts.init[].content</literal></entry><entry/></row>
          </tbody>
        </tgroup>
      </table>
    </section>
