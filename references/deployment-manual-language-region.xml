  <info>
   <title>Language and region</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
        Adjust your localization settings such as language, keyboard layout and time zone.
      </para>
    </abstract>
  </info>
  <informalfigure>
    <mediaobject>
      <textobject role="description"><phrase>Localization</phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata fileref="agama-installation-sles-localization.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata fileref="agama-installation-sles-localization.png" width="100%"/>
      </imageobject>
    </mediaobject>
  </informalfigure>
  <variablelist>
    <title>Language and region settings</title>
    <varlistentry>
      <term>Language</term>
      <listitem>
        <para>
          The language used for the system. It can be different from the language used during
          installation. Default value: <literal>English (United States)</literal>
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Keyboard</term>
      <listitem>
        <para>
          The keyboard used for the system. It can be different from the keyboard used during
          installation. Default value: <literal>English (US)</literal>
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Time Zone</term>
      <listitem>
        <para>
          The time zone of the system. The default value is determined automatically based on your
          network location.
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
</topic>
