 xmlns:trans="http://docbook.org/ns/transclusion">
  <info>
   <title>Registration</title>
    <meta name="maintainer" content="cwickert@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
       Register your product.
      </para>
    </abstract>
  </info>
  <informalfigure>
    <mediaobject>
      <textobject role="description"><phrase>Registration</phrase>
      </textobject>
      <imageobject role="fo">
        <imagedata fileref="agama-installation-sles-registration.png" width="100%"/>
      </imageobject>
      <imageobject role="html">
        <imagedata fileref="agama-installation-sles-registration.png" width="100%"/>
      </imageobject>
    </mediaobject>
  </informalfigure>
  <variablelist>
    <title>Registration settings</title>
    <varlistentry>
      <term>Registration server</term>
      <listitem>
        <variablelist>
          <varlistentry>
            <term>&sccfull; </term>
            <listitem>
              <para>
                Register with the &scc;. If your system is behind a firewall, make sure
                <link xlink:href="&sccurl;">&sccurl;</link> is reachable from your network.
              </para>
            </listitem>
          </varlistentry>
          <varlistentry>
            <term>Custom</term>
            <listitem>
              <para>
                Register with your own &smlm; or &rmt; infrastructure and provide the
                <guilabel>Server URL</guilabel>. Use this option for air-gapped environments.
              </para>
            </listitem>
          </varlistentry>
        </variablelist>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Registration code</term>
      <listitem>
        <para>
          Enter a valid registration code for &productname;. The code is hidden by default but can
          be shown by clicking on the eye icon.
        </para>
      </listitem>
    </varlistentry>
    <varlistentry>
      <term>Email (optional)</term>
      <listitem>
        <para>
          Optionally enter a valid email address. For organizations, it is recommended to use the
          address assigned to the registration code.
        </para>
      </listitem>
    </varlistentry>
  </variablelist>
  <para>
    Click <guimenu>Register</guimenu> to register the system.
  </para>
