<topic xml:id="rt-io-cpu-tuning-schedulers" xml:lang="en"
       role="reference"
       xmlns="http://docbook.org/ns/docbook" version="5.1"
       xmlns:its="http://www.w3.org/2005/11/its"
       xmlns:xi="http://www.w3.org/2001/XInclude"
       xmlns:xlink="http://www.w3.org/1999/xlink">
    <info>
        <meta name="maintainer" content="daria.vladykina@suse.com" its:translate="no"/>
        <title>Multi-queue I/O schedulers and key parameters</title>
        <abstract>
            <para>
            This section provides an overview of the available multi-queue block device I/O schedulers 
            and their <literal>sysfs</literal> tuning parameters.
            </para>
        </abstract>
    </info>
    <section xml:id="sec-ref-schedulers-table">
        <title>Available multi-queue I/O schedulers</title>
        <table xml:id="tab-blk-mq-schedulers">
            <title>Multi-queue I/O schedulers</title>
            <tgroup cols="3">
                <colspec colname="c1" colwidth="1*"/>
                <colspec colname="c2" colwidth="2*"/>
                <colspec colname="c3" colwidth="3*"/>
                <thead>
                    <row>
                        <entry>Scheduler</entry>
                        <entry>Typical use</entry>
                        <entry>Description</entry>
                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry><literal>none</literal></entry>
                        <entry>High-performance NVMe SSDs</entry>
                        <entry>Performs no reordering of requests and passes them directly to the hardware queues.</entry>
                    </row>
                    <row>
                        <entry><literal>mq-deadline</literal></entry>
                        <entry>SATA, SAS and traditional HDDs</entry>
                        <entry>The system default for most block devices. Tries to serve each request before its 
                            deadline to limit latency spikes and prevent write starvation.</entry>
                    </row>
                    <row>
                        <entry><literal>bfq</literal></entry>
                        <entry>Desktop environments and I/O-bound cgroups</entry>
                        <entry>Divides storage bandwidth proportionally between requesting processes or cgroups 
                            to maintain interactive responsiveness under heavy background loads.</entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </section>
    <section xml:id="sec-ref-tuneables-table">
        <title>Key <systemitem class="resource">sysfs</systemitem> parameters</title>
        <table xml:id="tab-iosched-tuneables">
            <title><literal>mq-deadline</literal> parameters</title>
            <tgroup cols="3">
                <colspec colname="c1" colwidth="2*"/>
                <colspec colname="c2" colwidth="1*"/>
                <colspec colname="c3" colwidth="3*"/>
                <thead>
                    <row>
                        <entry>Parameter</entry>
                        <entry>Unit</entry>
                        <entry>Description</entry>
                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry><literal>read_expire</literal></entry>
                        <entry>Milliseconds</entry>
                        <entry>Deadline for starting to serve a read request.</entry>
                    </row>
                    <row>
                        <entry><literal>write_expire</literal></entry>
                        <entry>Milliseconds</entry>
                        <entry>Deadline for starting to serve a write request.</entry>
                    </row>
                    <row>
                        <entry><literal>fifo_batch</literal></entry>
                        <entry>Requests</entry>
                        <entry>Number of requests moved to the dispatch queue at once when a request hits its deadline.</entry>
                    </row>
                    <row>
                        <entry><literal>front_merges</literal></entry>
                        <entry>Flag (<literal>0</literal> or <literal>1</literal>)</entry>
                        <entry>Enables or disables front merges of contiguous requests.</entry>
                    </row>
                    <row>
                        <entry><literal>writes_starved</literal></entry>
                        <entry>Count</entry>
                        <entry>How many times read requests are preferred before a pending write request is served.</entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </section>
</topic>
