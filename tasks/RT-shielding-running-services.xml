<topic xml:id="rt-shielding-resources-running-services"
 role="task" xml:lang="en"
 xmlns="http://docbook.org/ns/docbook" version="5.2"
 xmlns:its="http://www.w3.org/2005/11/its"
 xmlns:xi="http://www.w3.org/2001/XInclude"
 xmlns:xlink="http://www.w3.org/1999/xlink"
 xmlns:trans="http://docbook.org/ns/transclusion">
  <info>
    <title>Running jobs and services within a shield</title><!-- can be changed via merge
in the assembly -->
    <!-- add author's e-mail -->
    <meta name="maintainer" content="jsindelarova@suse.com" its:translate="no"/>
    <abstract><!-- can be changed via merge in the assembly -->
      <para>
    To execute workloads within the CPU shield, assign &systemd; service units or transient scopes to <filename>workload.slice</filename>.
  </para>
    </abstract>
  </info>  
  <procedure xml:id="pro-run-jobs-in-shield">
    <title>Assigning services and tasks to the shielded slice</title>
    <step>
      <para>
        Create a drop-in configuration file for your service to assign it to <filename>workload.slice</filename>.
      </para>
      <screen>&prompt.sudo;<command>cat /etc/systemd/system/sensitive.service.d/40-shielding.conf</command>
[Service]
Slice=workload.slice</screen>
    </step>
    <step>
      <para>
        Restart the service unit to apply the new slice configuration.
      </para>
      <screen>&prompt.sudo;<command>systemctl restart sensitive.service</command></screen>
    </step>
    <step>
      <para>
        To run an ad-hoc command inside the shield, execute it within a transient scope using <command>systemd-run</command>.
      </para>
      <screen>&prompt.sudo;<command>systemd-run --scope --uid=tux -p Slice=workload.slice command arg1</command></screen>
    </step>
  </procedure>
</topic>
