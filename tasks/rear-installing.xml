<!-- refers to legacy doc: https://github.com/SUSE/doc-sleha/blob/main/xml/ha_rear.xml -->

<topic xml:id="rear-installing"
 role="task" xml:lang="en"
 xmlns="http://docbook.org/ns/docbook" version="5.2"
 xmlns:its="http://www.w3.org/2005/11/its"
 xmlns:xi="http://www.w3.org/2001/XInclude"
 xmlns:xlink="http://www.w3.org/1999/xlink"
 xmlns:trans="http://docbook.org/ns/transclusion">
  <info>
    <title>Installing &rear;</title>
    <meta name="maintainer" content="tahlia.richardson@suse.com" its:translate="no"/>
    <abstract>
      <para>
        Install &rear; on the system you want to back up:
      </para>
    </abstract>
  </info>

  <procedure>
    <step>
      <para>
        Log in either as the &rootuser; user or as a user with <command>sudo</command> privileges.
      </para>
    </step>
    <step>
      <para>
        Install &rear;:
      </para>
      <itemizedlist>
        <listitem>
          <para>
            To install the latest version of &rear;, run the following command:
          </para>
<screen>&prompt.user;<command>sudo zypper install rear</command></screen>
        </listitem>
        <listitem>
          <para>
            If you need to install a specific version of &rear;, you can specify the package version.
            For example:
          </para>
<screen>&prompt.user;<command>sudo zypper install rear29a</command></screen>
        </listitem>
      </itemizedlist>
    </step>
    <step>
      <para>
        If your system boots with a UEFI boot loader, make sure the <package>xorriso</package>
        package is installed:
      </para>
<screen>&prompt.user;<command>sudo zypper install xorriso</command></screen>
    </step>
  </procedure>
</topic>
